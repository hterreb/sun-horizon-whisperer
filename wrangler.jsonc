// Cloudflare Worker config for sun.chaser.page (ROADMAP item 16). Workers Builds runs
// `npm run build`, then `npx wrangler deploy`. The name is the Worker in the dashboard.
{
  "name": "sun-chaser",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
